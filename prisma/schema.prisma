generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["prisma_app"]
}

/// Ruang kerja penelitian (multi-tenant). Setiap akun peneliti memiliki
/// tepat satu Project miliknya sendiri; semua data penelitian (kode,
/// responden, jawaban, log) diisolasi melalui projectId.
///
/// ownerId menyimpan:
///   - Supabase Auth user id (uuid, dari auth.users.id) untuk akun baru
///     yang dibuat lewat halaman Registrasi, ATAU
///   - "legacy:<username>" untuk akun admin lama (admin_users) yang sudah
///     ada sebelum fitur multi-tenant ini ditambahkan — datanya yang sudah
///     ada dipindahkan ke satu Project "Legacy" otomatis (lihat
///     prisma/migration-multitenant.sql) sehingga tidak ada data yang
///     hilang/hangus saat migrasi.
model Project {
  id                String         @id @default(cuid())
  ownerId           String         @unique // supabase auth.users.id, atau "legacy:<username>"
  ownerEmail        String?
  ownerName         String? // Nama Lengkap peneliti
  username          String?        @unique // Username peneliti (opsional, unik)
  name              String // Nama Project
  researchTitle     String? // Judul Penelitian
  institution        String? // Institusi
  phone             String? // Nomor HP
  targetRespondents Int            @default(100)
  status            String         @default("active")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  respondents       Respondent[]
  researchCodes     ResearchCode[]
  auditLogs         AuditLog[]
  settings          Setting[]

  @@schema("prisma_app")
}

/// Responden (siswa SMP) yang mengikuti penelitian
model Respondent {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String
  school       String?
  status       String             @default("pending")
  currentStage String             @default("welcome")
  stageIndex   Int                @default(0)
  highRisk     Boolean            @default(false)
  consentGiven Boolean            @default(false)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  auditLogs    AuditLog[]
  bullying     BullyingAnswer?
  cesdr        CesdrAnswer?
  demographic  Demographic?
  mos          MosAnswer?
  psqi         PsqiAnswer?
  religiosity  ReligiosityAnswer?
  screentime   ScreenTimeAnswer?

  // Kode responden unik PER PROJECT (bukan global), sehingga setiap akun
  // baru bisa mulai lagi dari RESP-0001 tanpa bentrok dengan akun lain.
  @@unique([projectId, code])
  @@index([status])
  @@index([highRisk])
  @@index([projectId])
  @@schema("prisma_app")
}

/// Kode penelitian yang dibuat admin
model ResearchCode {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code       String
  school     String?
  classGrade String?
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([projectId, code])
  @@index([projectId])
  @@schema("prisma_app")
}

/// Admin penelitian (sistem login lama — dipertahankan untuk kompatibilitas
/// mundur; akun baru sebaiknya mendaftar lewat halaman Registrasi yang
/// memakai Supabase Auth, lihat Project.ownerId)
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@schema("prisma_app")
}

/// Data demografi responden (JSON blob untuk fleksibilitas)
model Demographic {
  id           String     @id @default(cuid())
  respondentId String     @unique
  data         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban CESD-R (20 item)
model CesdrAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  highRisk     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban PSQI
model PsqiAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban Screen Time & Media Sosial
model ScreenTimeAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban MOS-SSS (social support)
model MosAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban Gatehouse Bullying Scale
model BullyingAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  victimScore  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban Praktik Ibadah / Religiusitas
model ReligiosityAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Audit trail
model AuditLog {
  id           String      @id @default(cuid())
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  respondentId String?
  action       String
  detail       String?
  createdAt    DateTime    @default(now())
  respondent   Respondent? @relation(fields: [respondentId], references: [id])

  @@index([action])
  @@index([projectId])
  @@schema("prisma_app")
}

/// Key-value settings store (target respondents, schools, contact info, etc.)
/// Sekarang per-project — setiap akun peneliti punya pengaturannya sendiri.
model Setting {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([projectId, key])
  @@schema("prisma_app")
}
