generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["prisma_app"]
}

/// Responden (siswa SMP) yang mengikuti penelitian
model Respondent {
  id           String             @id @default(cuid())
  code         String             @unique
  school       String?
  status       String             @default("pending")
  currentStage String             @default("welcome")
  stageIndex   Int                @default(0)
  highRisk     Boolean            @default(false)
  consentGiven Boolean            @default(false)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  auditLogs    AuditLog[]
  bullying     BullyingAnswer?
  cesdr        CesdrAnswer?
  demographic  Demographic?
  mos          MosAnswer?
  psqi         PsqiAnswer?
  religiosity  ReligiosityAnswer?
  screentime   ScreenTimeAnswer?

  @@index([status])
  @@index([highRisk])
  @@schema("prisma_app")
}

/// Kode penelitian yang dibuat admin
model ResearchCode {
  code       String   @id
  school     String?
  classGrade String?
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@schema("prisma_app")
}

/// Admin penelitian
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@schema("prisma_app")
}

/// Data demografi responden (JSON blob untuk fleksibilitas)
model Demographic {
  id           String     @id @default(cuid())
  respondentId String     @unique
  data         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban CESD-R (20 item)
model CesdrAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  highRisk     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban PSQI
model PsqiAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban Screen Time & Media Sosial
model ScreenTimeAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban MOS-SSS (social support)
model MosAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban Gatehouse Bullying Scale
model BullyingAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  victimScore  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Jawaban Praktik Ibadah / Religiusitas
model ReligiosityAnswer {
  id           String     @id @default(cuid())
  respondentId String     @unique
  answers      String
  totalScore   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@schema("prisma_app")
}

/// Audit trail
model AuditLog {
  id           String      @id @default(cuid())
  respondentId String?
  action       String
  detail       String?
  createdAt    DateTime    @default(now())
  respondent   Respondent? @relation(fields: [respondentId], references: [id])

  @@index([action])
  @@schema("prisma_app")
}

/// Key-value settings store (target respondents, schools, contact info, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@schema("prisma_app")
}
